# ============================================================
# .ovpn config for Netherlands server
#
# LOCAL TESTING: points to 10.0.2.2 (Android emulator → Windows host)
# Run local_test_server/setup.ps1 to populate this with real certs.
# For production: replace 10.0.2.2 with your real server IP.
# ============================================================
client
dev tun
proto udp
remote 10.0.2.2 1194
resolv-retry infinite
nobind
persist-key
persist-tun
cipher AES-256-GCM
auth SHA256
verb 3
# TLS/cert blocks are injected by setup.ps1 when using the local Docker server
